# A vision-capable model available to your OpenAI account.
OPENAI_MODEL=
OPENAI_API_KEY=

AI_WORKERS=1
# Host port for Docker Compose. Native runs use port 8000 by default.
HOST_PORT=8000

# Native data directory. Compose always uses /data.
# APP_DATA_DIR=./data

# Optional path to a versioned pricing JSON file.
# With Compose, use an absolute container path such as /data/pricing.json.
AI_PRICING_FILE=
